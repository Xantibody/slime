{
  "name": "slime",
  "version": "1.1.2",
  "description": "Chrome extension to fix Japanese IME double-display issue in Slite",
  "type": "module",
  "scripts": {
    "test": "vitest",
    "test:run": "vitest run",
    "build": "node --experimental-strip-types scripts/build.ts",
    "build:chrome": "node --experimental-strip-types scripts/build.ts chrome",
    "build:firefox": "node --experimental-strip-types scripts/build.ts firefox",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src scripts e2e vitest.config.ts",
    "knip": "knip",
    "fmt": "treefmt",
    "fmt:check": "treefmt --ci",
    "package:source": "git archive -o dist/slime-source-v${VERSION:?}.zip HEAD",
    "e2e": "pnpm build && node --experimental-strip-types e2e/run.ts",
    "check": "pnpm fmt:check && pnpm lint && pnpm typecheck && pnpm knip && pnpm test:run"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.5",
    "@types/firefox-webext-browser": "^143.0.0",
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "knip": "^6.32.2",
    "vitest": "^2.0.0"
  }
}
