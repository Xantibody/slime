{
  "$schema": "https://unpkg.com/knip@6/schema.json",

  // An extension is only ever called into. The files manifest.json and the
  // build script point at are the entries; whatever they cannot reach is
  // truly unused
  "entry": [
    "src/inject.ts",
    "src/content-script.ts",
    "src/popup.ts",
    "src/background.chrome.ts",
    "src/background.firefox.ts",
    "e2e/verify.js",
  ],
  "project": ["src/**/*.ts", "scripts/**/*.ts", "e2e/**/*.{ts,js}"],

  // Tools that flake.nix's toolchain provides; they never appear in package.json
  "ignoreBinaries": ["tsc", "oxlint", "treefmt", "vale", "typos", "agent-browser"],

  // Read only through tsconfig.json's `types`, never by an import
  "ignoreDependencies": ["@types/chrome", "@types/firefox-webext-browser"],
}
